    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "dompurify": "^3.4.17",
    "framer-motion": "^14.10.1",
    "i18next": "^26.7.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^7.18.5",
