# Public API base URL (no trailing slash required; client normalizes it).
# Must point at the Express mount path `/api/v1`.
#
# Development (backend default PORT=5000):
VITE_API_BASE_URL=http://localhost:5000/api/v1
#
# Production (Vercel): set this in the host dashboard to your Railway API, for example:
# VITE_API_BASE_URL=https://YOUR-RAILWAY-API.up.railway.app/api/v1
#
# Do not put JWT secrets, database credentials, or other private values in VITE_* variables.
#
# Optional browser error monitoring (public DSN only — never private keys):
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0
