}

model AssignmentSubmission {
  id           Int              @id @default(autoincrement())
  assignmentId Int              @map("assignment_id")
  studentId    Int              @map("student_id")
  content      String?          @db.Text
  status       SubmissionStatus @default(SUBMITTED)
  score        Decimal?         @db.Decimal(8, 2)
  feedback     String?          @db.Text
  submittedAt  DateTime         @default(now()) @map("submitted_at")
  gradedAt     DateTime?        @map("graded_at")
  gradedById   Int?             @map("graded_by_id")
  deletedAt    DateTime?        @map("deleted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  gradedBy   Teacher?   @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([assignmentId, studentId], map: "submission_assignment_student_key")
  @@index([studentId])
  @@index([status])
  @@index([deletedAt])
  @@map("assignment_submissions")
}

enum ExamMarksStatus {
  DRAFT
  SUBMITTED
}

enum GradeWeightMode {
  RELATIVE
  PERCENT
}

/// Configurable letter-grade scale for gradebook calculations.
model GradingScale {
  id                  Int             @id @default(autoincrement())
  name                String          @db.VarChar(100)
  description         String?         @db.VarChar(500)
  isDefault           Boolean         @default(false) @map("is_default")
  weightMode          GradeWeightMode @default(RELATIVE) @map("weight_mode")
  treatMissingAsZero  Boolean         @default(false) @map("treat_missing_as_zero")
  decimalPlaces       Int             @default(2) @map("decimal_places")
  deletedAt           DateTime?       @map("deleted_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  boundaries GradeBoundary[]

  @@index([isDefault])
  @@index([deletedAt])
  @@map("grading_scales")
}

model GradeBoundary {
  id             Int     @id @default(autoincrement())
  gradingScaleId Int     @map("grading_scale_id")
  letter         String  @db.VarChar(5)
  minPercent     Decimal @map("min_percent") @db.Decimal(5, 2)
  maxPercent     Decimal @map("max_percent") @db.Decimal(5, 2)
  remark         String? @db.VarChar(255)
  sortOrder      Int     @default(0) @map("sort_order")

  gradingScale GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([gradingScaleId])
  @@map("grade_boundaries")
}

/// Assessment categories (classwork, quiz, midterm, …) with configurable default weights.
model AssessmentCategory {
  id            Int       @id @default(autoincrement())
  code          String    @unique @db.VarChar(50)
  name          String    @db.VarChar(100)
  description   String?   @db.VarChar(500)
  defaultWeight Decimal   @default(1) @map("default_weight") @db.Decimal(8, 2)
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  examinations Examination[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("assessment_categories")
}

model Examination {
  id              Int             @id @default(autoincrement())
  name            String          @db.VarChar(255)
  examType        String          @default("MIDTERM") @map("exam_type") @db.VarChar(50)
  classOfferingId Int             @map("class_offering_id")
  subjectId       Int             @map("subject_id")
  academicYearId  Int             @map("academic_year_id")
  academicTermId  Int?            @map("academic_term_id")
  examDate        DateTime?       @map("exam_date") @db.Date
  maxScore        Decimal         @default(100) @map("max_score") @db.Decimal(8, 2)
  categoryId      Int?            @map("category_id")
  weight          Decimal         @default(1) @map("weight") @db.Decimal(8, 2)
  marksStatus     ExamMarksStatus @default(DRAFT) @map("marks_status")
  submittedAt     DateTime?       @map("submitted_at")
  submittedById   Int?            @map("submitted_by_id")
  isPublished     Boolean         @default(false) @map("is_published")
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  classOffering ClassOffering       @relation(fields: [classOfferingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject       Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear  AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicTerm  AcademicTerm?       @relation(fields: [academicTermId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category      AssessmentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  submittedBy   Teacher?            @relation("ExaminationSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  results       ExamResult[]

  @@index([classOfferingId])
  @@index([subjectId])
  @@index([academicYearId])
  @@index([academicTermId])
  @@index([categoryId])
  @@index([marksStatus])
  @@index([deletedAt])
  @@map("examinations")
}

model ExamResult {
  id          Int       @id @default(autoincrement())
  examId      Int       @map("exam_id")
  studentId   Int       @map("student_id")
  score       Decimal   @db.Decimal(8, 2)
  gradeLetter String?   @map("grade_letter") @db.VarChar(5)
  remarks     String?   @db.VarChar(500)
  enteredById Int?      @map("entered_by_id")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  exam      Examination @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enteredBy Teacher?    @relation("ExamResultEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([examId, studentId], map: "exam_result_exam_student_key")
  @@index([studentId])
  @@index([deletedAt])
  @@map("exam_results")
}

model FeeStructure {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("ETB") @db.VarChar(10)
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  studentFees StudentFee[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("fee_structures")
}

model StudentFee {
  id             Int              @id @default(autoincrement())
  studentId      Int              @map("student_id")
  feeStructureId Int              @map("fee_structure_id")
  academicYearId Int              @map("academic_year_id")
  academicTermId Int?             @map("academic_term_id")
  amountDue      Decimal          @map("amount_due") @db.Decimal(12, 2)
  amountPaid     Decimal          @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status         FeePaymentStatus @default(UNPAID)
  dueDate        DateTime?        @map("due_date") @db.Date
  notes          String?          @db.VarChar(500)
  deletedAt      DateTime?        @map("deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments     FeePayment[]

  @@index([studentId])
  @@index([feeStructureId])
  @@index([academicYearId])
  @@index([status])
  @@index([deletedAt])
  @@map("student_fees")
}

model FeePayment {
  id              Int       @id @default(autoincrement())
  studentFeeId    Int       @map("student_fee_id")
  amount          Decimal   @db.Decimal(12, 2)
  paymentMethod   String?   @map("payment_method") @db.VarChar(50)
  reference       String?   @db.VarChar(100)
  paidAt          DateTime  @default(now()) @map("paid_at")
  recordedById    Int?      @map("recorded_by_id")
  notes           String?   @db.VarChar(500)
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recordedBy Admin?     @relation("FeePaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([studentFeeId])
  @@index([paidAt])
  @@index([deletedAt])
  @@map("fee_payments")
}

model Announcement {
  id              Int                  @id @default(autoincrement())
