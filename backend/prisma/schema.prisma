// High School Website Platform — core database schema (MySQL + Prisma 7)
// Credentials belong in environment variables / prisma.config.cjs, not here.

generator client {
  // Keep JavaScript client generation (no TypeScript toolchain required).
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum NewsletterStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum AdmissionInquiryStatus {
  NEW
  CONTACTED
  UNDER_REVIEW
  CLOSED
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
  LATE
}

enum FeePaymentStatus {
  UNPAID
  PARTIAL
  PAID
  WAIVED
}

enum AnnouncementAudience {
  ALL
  TEACHERS
  STUDENTS
  CLASS
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum LearningMaterialCategory {
  NOTES
  HANDOUT
  SLIDES
  WORKSHEET
  ASSIGNMENT_RESOURCE
  OTHER
}

enum AuditActorType {
  ADMIN
  TEACHER
  STUDENT
  SYSTEM
}

// ---------------------------------------------------------------------------
// Administrator management
// ---------------------------------------------------------------------------

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  admins Admin[]

  @@map("roles")
}

model Admin {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  isActive     Boolean   @default(true) @map("is_active")
  // Incremented on logout so previously issued JWTs become invalid.
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  roleId Int  @map("role_id")
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  pagesCreated       Page[]               @relation("PageCreatedBy")
  pagesUpdated       Page[]               @relation("PageUpdatedBy")
  blogPosts          BlogPost[]           @relation("BlogPostAuthor")
  contactMessages    ContactMessage[]     @relation("ContactMessageHandledBy")
  eventsCreated      Event[]              @relation("EventCreatedBy")
  mediaUploads       MediaAsset[]         @relation("MediaUploadedBy")
  settingsUpdated    WebsiteSetting[]     @relation("SettingUpdatedBy")
  auditLogs          AuditLog[]           @relation("AuditLogAdmin")
  announcements      Announcement[]       @relation("AnnouncementCreatedBy")
  feePaymentsRecorded FeePayment[]        @relation("FeePaymentRecordedBy")
  timetablesCreated  Timetable[]          @relation("TimetableCreatedBy")
  learningMaterialsArchived LearningMaterial[] @relation("LearningMaterialArchivedBy")
  notifications      Notification[]       @relation("NotificationAdminRecipient")
  conversationParticipants ConversationParticipant[] @relation("ConversationParticipantAdmin")
  messagesSent       Message[]            @relation("MessageSentByAdmin")

  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("admins")
}

// ---------------------------------------------------------------------------
// Website pages
// ---------------------------------------------------------------------------

model Page {
  id          Int               @id @default(autoincrement())
  title       String            @db.VarChar(255)
  slug        String            @unique @db.VarChar(255)
  content     String            @db.LongText
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?         @map("published_at")
  deletedAt   DateTime?         @map("deleted_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  createdById Int?   @map("created_by_id")
  updatedById Int?   @map("updated_by_id")
  createdBy   Admin? @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedBy   Admin? @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("pages")
}

// ---------------------------------------------------------------------------
// Blog management
// ---------------------------------------------------------------------------

model BlogCategory {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(150)
  slug        String    @unique @db.VarChar(150)
  description String?   @db.VarChar(500)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  posts BlogPost[]

  @@index([deletedAt])
  @@map("blog_categories")
}

model BlogPost {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(255)
  slug        String         @unique @db.VarChar(255)
  excerpt     String?        @db.VarChar(500)
  content     String         @db.LongText
  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?      @map("published_at")
  deletedAt   DateTime?      @map("deleted_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  authorId        Int  @map("author_id")
  categoryId      Int? @map("category_id")
  featuredImageId Int? @map("featured_image_id")

  author        Admin         @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category      BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  featuredImage MediaAsset?   @relation("BlogPostFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
  @@index([categoryId])
  @@index([featuredImageId])
  @@index([deletedAt])
  @@map("blog_posts")
}

// ---------------------------------------------------------------------------
// Contact messages
// ---------------------------------------------------------------------------

model ContactMessage {
  id        Int                  @id @default(autoincrement())
  name      String               @db.VarChar(150)
  email     String               @db.VarChar(255)
  phone     String?              @db.VarChar(50)
  subject   String               @db.VarChar(255)
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  handledById Int?   @map("handled_by_id")
  handledBy   Admin? @relation("ContactMessageHandledBy", fields: [handledById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([handledById])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Newsletter
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id                         Int              @id @default(autoincrement())
  email                      String           @unique @db.VarChar(255)
  status                     NewsletterStatus @default(PENDING)
  confirmationTokenHash      String?          @unique @map("confirmation_token_hash") @db.VarChar(64)
  confirmationTokenExpiresAt DateTime?        @map("confirmation_token_expires_at")
  confirmedAt                DateTime?        @map("confirmed_at")
  unsubscribeTokenHash       String?          @unique @map("unsubscribe_token_hash") @db.VarChar(64)
  unsubscribedAt             DateTime?        @map("unsubscribed_at")
  deletedAt                  DateTime?        @map("deleted_at")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------------------------
// Admissions inquiries (inquiry inbox only — not a full enrollment system)
// ---------------------------------------------------------------------------

model AdmissionInquiry {
  id               Int                     @id @default(autoincrement())
  studentName      String                  @map("student_name") @db.VarChar(150)
  guardianName     String?                 @map("guardian_name") @db.VarChar(150)
  email            String                  @db.VarChar(255)
  phone            String                  @db.VarChar(50)
  gradeApplyingFor String                  @map("grade_applying_for") @db.VarChar(50)
  academicYear     String                  @map("academic_year") @db.VarChar(20)
  message          String                  @db.Text
  status           AdmissionInquiryStatus  @default(NEW)
  deletedAt        DateTime?               @map("deleted_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([gradeApplyingFor])
  @@index([academicYear])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("admission_inquiries")
}

// ---------------------------------------------------------------------------
// School events
// ---------------------------------------------------------------------------

model Event {
  id          Int         @id @default(autoincrement())
  title       String      @db.VarChar(255)
  slug        String      @unique @db.VarChar(255)
  description String      @db.Text
  location    String?     @db.VarChar(255)
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime?   @map("ends_at")
  status      EventStatus @default(DRAFT)
  publishedAt DateTime?   @map("published_at")
  deletedAt   DateTime?   @map("deleted_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  createdById     Int? @map("created_by_id")
  featuredImageId Int? @map("featured_image_id")

  createdBy     Admin?      @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  featuredImage MediaAsset? @relation("EventFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([createdById])
  @@index([featuredImageId])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Media management (metadata only — no binary file storage in MySQL)
// ---------------------------------------------------------------------------

model MediaAsset {
  id            Int       @id @default(autoincrement())
  /** Cryptographically random public identifier used in public content URLs (not sequential). */
  publicId      String    @unique @map("public_id") @db.VarChar(64)
  fileName      String    @map("file_name") @db.VarChar(255)
  originalName  String    @map("original_name") @db.VarChar(255)
  mimeType      String    @map("mime_type") @db.VarChar(100)
  fileSize      Int       @map("file_size")
  storagePath   String    @map("storage_path") @db.VarChar(500)
  altText       String?   @map("alt_text") @db.VarChar(255)
  description   String?   @db.VarChar(500)
  isGalleryImage Boolean  @default(false) @map("is_gallery_image")
  sortOrder     Int       @default(0) @map("sort_order")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  uploadedById Int?   @map("uploaded_by_id")
  uploadedBy   Admin? @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  blogPostsAsFeatured BlogPost[] @relation("BlogPostFeaturedImage")
  eventsAsFeatured    Event[]    @relation("EventFeaturedImage")

  @@index([mimeType])
  @@index([isGalleryImage])
  @@index([sortOrder])
  @@index([uploadedById])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// Website settings (key/value configuration)
// ---------------------------------------------------------------------------

model WebsiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  group     String?  @db.VarChar(100)
  label     String?  @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  updatedById Int?   @map("updated_by_id")
  updatedBy   Admin? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([group])
  @@index([updatedById])
  @@map("website_settings")
}

// ---------------------------------------------------------------------------
// Audit logs
// ---------------------------------------------------------------------------

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  // Existing admin FK preserved; optional polymorphic actor for SMS identities.
  actorType AuditActorType? @map("actor_type")
  actorId   Int?            @map("actor_id")

  adminId   Int?     @map("admin_id")
  admin     Admin?   @relation("AuditLogAdmin", fields: [adminId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherId Int?     @map("teacher_id")
  teacher   Teacher? @relation("AuditLogTeacher", fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  studentId Int?     @map("student_id")
  student   Student? @relation("AuditLogStudent", fields: [studentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([adminId])
  @@index([teacherId])
  @@index([studentId])
  @@index([actorType, actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// School Management System — Phase 2 identity + academic structure
// Three actors only: Admin (existing), Teacher, Student. No Parent.
// ---------------------------------------------------------------------------

model Teacher {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  employeeCode String?   @unique @map("employee_code") @db.VarChar(50)
  phone        String?   @db.VarChar(50)
  isActive     Boolean   @default(true) @map("is_active")
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  homeroomClasses     ClassOffering[]      @relation("ClassHomeroomTeacher")
  teachingAssignments TeachingAssignment[]
  auditLogs           AuditLog[]           @relation("AuditLogTeacher")
  attendanceRecorded  AttendanceRecord[]   @relation("AttendanceRecordedBy")
  assignmentsCreated  Assignment[]         @relation("AssignmentCreatedBy")
  submissionsGraded   AssignmentSubmission[] @relation("SubmissionGradedBy")
  examResultsEntered  ExamResult[]         @relation("ExamResultEnteredBy")
  examinationsSubmitted Examination[]      @relation("ExaminationSubmittedBy")
  timetableEntries    TimetableEntry[]
  learningMaterials   LearningMaterial[]
  notifications       Notification[]       @relation("NotificationTeacherRecipient")
  conversationParticipants ConversationParticipant[] @relation("ConversationParticipantTeacher")
  messagesSent        Message[]            @relation("MessageSentByTeacher")

  @@index([isActive])
  @@index([deletedAt])
  @@map("teachers")
}

model Student {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  studentCode   String    @unique @map("student_code") @db.VarChar(50)
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        String?   @db.VarChar(30)
  phone         String?   @db.VarChar(50)
  guardianName  String?   @map("guardian_name") @db.VarChar(150)
  guardianPhone String?   @map("guardian_phone") @db.VarChar(50)
  isActive      Boolean   @default(true) @map("is_active")
  tokenVersion  Int       @default(0) @map("token_version")
  lastLoginAt   DateTime? @map("last_login_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  enrollments  Enrollment[]
  auditLogs    AuditLog[]              @relation("AuditLogStudent")
  attendance   AttendanceRecord[]
  submissions  AssignmentSubmission[]
  examResults  ExamResult[]
  studentFees  StudentFee[]
  notifications Notification[]         @relation("NotificationStudentRecipient")
  conversationParticipants ConversationParticipant[] @relation("ConversationParticipantStudent")
  messagesSent Message[]               @relation("MessageSentByStudent")

  @@index([isActive])
  @@index([deletedAt])
  @@map("students")
}

model AcademicYear {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  code      String    @unique @db.VarChar(50)
  startsOn  DateTime  @map("starts_on") @db.Date
  endsOn    DateTime  @map("ends_on") @db.Date
  isCurrent Boolean   @default(false) @map("is_current")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  terms           AcademicTerm[]
  classOfferings  ClassOffering[]
  enrollments     Enrollment[]
  studentFees     StudentFee[]
  examinations    Examination[]
  timetables      Timetable[]
  learningMaterials LearningMaterial[]

  @@index([isCurrent])
  @@index([deletedAt])
  @@map("academic_years")
}

model AcademicTerm {
  id             Int       @id @default(autoincrement())
  academicYearId Int       @map("academic_year_id")
  name           String    @db.VarChar(100)
  sequence       Int
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime  @map("ends_on") @db.Date
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teachingAssignments TeachingAssignment[]
  examinations        Examination[]
  studentFees         StudentFee[]
  timetables          Timetable[]
  learningMaterials   LearningMaterial[]

  @@unique([academicYearId, sequence])
  @@index([academicYearId])
  @@index([deletedAt])
  @@map("academic_terms")
}

model GradeLevel {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  code      String    @unique @db.VarChar(20)
  sortOrder Int       @default(0) @map("sort_order")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  classOfferings ClassOffering[]

  @@index([sortOrder])
  @@index([deletedAt])
  @@map("grade_levels")
}

model Section {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  code      String    @unique @db.VarChar(20)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  classOfferings ClassOffering[]

  @@index([deletedAt])
  @@map("sections")
}

model Subject {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(150)
  code        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(500)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  teachingAssignments TeachingAssignment[]
  assignments         Assignment[]
  examinations        Examination[]
  timetableEntries    TimetableEntry[]
  learningMaterials   LearningMaterial[]

  @@index([deletedAt])
  @@map("subjects")
}

model ClassOffering {
  id                Int       @id @default(autoincrement())
  academicYearId    Int       @map("academic_year_id")
  gradeLevelId      Int       @map("grade_level_id")
  sectionId         Int       @map("section_id")
  name              String    @db.VarChar(150)
  homeroomTeacherId Int?      @map("homeroom_teacher_id")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  gradeLevel          GradeLevel           @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  section             Section              @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  homeroomTeacher     Teacher?             @relation("ClassHomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teachingAssignments TeachingAssignment[]
  enrollments         Enrollment[]
  attendanceRecords   AttendanceRecord[]
  assignments         Assignment[]
  examinations        Examination[]
  announcements       Announcement[]
  timetables          Timetable[]
  learningMaterials   LearningMaterial[]

  @@unique([academicYearId, gradeLevelId, sectionId])
  @@index([academicYearId])
  @@index([gradeLevelId])
  @@index([sectionId])
  @@index([homeroomTeacherId])
  @@index([deletedAt])
  @@map("class_offerings")
}

model TeachingAssignment {
  id              Int       @id @default(autoincrement())
  teacherId       Int       @map("teacher_id")
  classOfferingId Int       @map("class_offering_id")
  subjectId       Int       @map("subject_id")
  academicTermId  Int?      @map("academic_term_id")
  /// NULL-safe unique companion: "YEAR" when academicTermId is null, else term id string.
  termScopeKey    String    @map("term_scope_key") @db.VarChar(40)
  isPrimary       Boolean   @default(false) @map("is_primary")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  teacher       Teacher        @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  classOffering ClassOffering  @relation(fields: [classOfferingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicTerm  AcademicTerm?  @relation(fields: [academicTermId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teacherId, classOfferingId, subjectId, termScopeKey])
  @@index([teacherId])
  @@index([classOfferingId])
  @@index([subjectId])
  @@index([academicTermId])
  @@index([deletedAt])
  @@map("teaching_assignments")
}

model Enrollment {
  id              Int              @id @default(autoincrement())
  studentId       Int              @map("student_id")
  classOfferingId Int              @map("class_offering_id")
  academicYearId  Int              @map("academic_year_id")
  status          EnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime         @default(now()) @map("enrolled_at")
  leftAt          DateTime?        @map("left_at")
  /// Active uniqueness key: studentId:classOfferingId while live; rewritten on soft-delete.
  activeScopeKey  String           @unique @map("active_scope_key") @db.VarChar(80)
  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  student       Student       @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  classOffering ClassOffering @relation(fields: [classOfferingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([studentId])
  @@index([classOfferingId])
  @@index([academicYearId])
  @@index([status])
  @@index([deletedAt])
  @@map("enrollments")
}

