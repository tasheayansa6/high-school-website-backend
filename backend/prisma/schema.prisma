  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  classOffering ClassOffering          @relation(fields: [classOfferingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject       Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teacher       Teacher                @relation("AssignmentCreatedBy", fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submissions   AssignmentSubmission[]

  @@index([classOfferingId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([dueAt])
  @@index([deletedAt])
