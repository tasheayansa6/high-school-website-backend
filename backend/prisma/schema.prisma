  publishedAt     DateTime?            @map("published_at")
  createdById     Int                  @map("created_by_id")
  deletedAt       DateTime?            @map("deleted_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  classOffering ClassOffering? @relation(fields: [classOfferingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy     Admin          @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([audience])
  @@index([classOfferingId])
  @@index([isPublished])
  @@index([deletedAt])
  @@map("announcements")
}

// ---------------------------------------------------------------------------
// SMS timetable module
// ---------------------------------------------------------------------------

model Classroom {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(150)
  code      String    @unique @db.VarChar(50)
  capacity  Int?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  timetableEntries TimetableEntry[]

  @@index([deletedAt])
  @@map("classrooms")
}

/// Weekly timetable container for one class offering within a year (and optional term).
model Timetable {
  id              Int       @id @default(autoincrement())
  academicYearId  Int       @map("academic_year_id")
  academicTermId  Int?      @map("academic_term_id")
  /// "YEAR" when academicTermId is null, else the term id as string.
  termScopeKey    String    @map("term_scope_key") @db.VarChar(40)
  classOfferingId Int       @map("class_offering_id")
  title           String?   @db.VarChar(255)
  isPublished     Boolean   @default(false) @map("is_published")
  publishedAt     DateTime? @map("published_at")
  createdById     Int       @map("created_by_id")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicTerm  AcademicTerm?  @relation(fields: [academicTermId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  classOffering ClassOffering  @relation(fields: [classOfferingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy     Admin          @relation("TimetableCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  entries       TimetableEntry[]

  @@unique([classOfferingId, termScopeKey])
  @@index([academicYearId])
  @@index([academicTermId])
  @@index([classOfferingId])
  @@index([isPublished])
  @@index([deletedAt])
  @@map("timetables")
}

model TimetableEntry {
  id          Int       @id @default(autoincrement())
  timetableId Int       @map("timetable_id")
  dayOfWeek   Weekday   @map("day_of_week")
  /// Local wall-clock time as HH:mm (24h).
  startTime   String    @map("start_time") @db.Char(5)
  endTime     String    @map("end_time") @db.Char(5)
  subjectId   Int       @map("subject_id")
  teacherId   Int       @map("teacher_id")
  classroomId Int?      @map("classroom_id")
  isActive    Boolean   @default(true) @map("is_active")
  notes       String?   @db.VarChar(500)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  timetable Timetable  @relation(fields: [timetableId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teacher   Teacher    @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  classroom Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([timetableId])
  @@index([dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([classroomId, dayOfWeek])
  @@index([subjectId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("timetable_entries")
}

// ---------------------------------------------------------------------------
// SMS learning materials module
// ---------------------------------------------------------------------------

/// Teacher-uploaded class resource. File bytes live on disk via storage.service;
/// only metadata is stored in MySQL.
model LearningMaterial {
  id              Int                       @id @default(autoincrement())
  title           String                    @db.VarChar(255)
  description     String?                   @db.VarChar(2000)
  category        LearningMaterialCategory  @default(OTHER)
  academicYearId  Int                       @map("academic_year_id")
  academicTermId  Int?                      @map("academic_term_id")
  classOfferingId Int                       @map("class_offering_id")
  subjectId       Int                       @map("subject_id")
  teacherId       Int                       @map("teacher_id")
  /// Stored file basename (from storage key).
  fileName        String                    @map("file_name") @db.VarChar(255)
  originalName    String                    @map("original_name") @db.VarChar(255)
  mimeType        String                    @map("mime_type") @db.VarChar(120)
  fileSize        Int                       @map("file_size")
  /// Relative key under MEDIA_STORAGE_PATH (never absolute).
  storagePath     String                    @map("storage_path") @db.VarChar(500)
  isPublished     Boolean                   @default(false) @map("is_published")
  publishedAt     DateTime?                 @map("published_at")
  archivedAt      DateTime?                 @map("archived_at")
  archivedById    Int?                      @map("archived_by_id")
  deletedAt       DateTime?                 @map("deleted_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicTerm  AcademicTerm?  @relation(fields: [academicTermId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  classOffering ClassOffering  @relation(fields: [classOfferingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teacher       Teacher        @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  archivedBy    Admin?         @relation("LearningMaterialArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([academicYearId])
  @@index([academicTermId])
  @@index([classOfferingId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([category])
  @@index([isPublished])
  @@index([archivedAt])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("learning_materials")
}

// ---------------------------------------------------------------------------
// Notifications module
// ---------------------------------------------------------------------------

enum NotificationRecipientType {
  ADMIN
  TEACHER
  STUDENT
}

enum NotificationCategory {
  ACADEMIC
  ATTENDANCE
  TIMETABLE
  LEARNING_MATERIAL
  ANNOUNCEMENT
  ADMINISTRATION
  MESSAGING
}

/// Persisted in-app notifications. Polymorphic recipient via type + id FKs.
model Notification {
  id                 Int                       @id @default(autoincrement())
  recipientType      NotificationRecipientType @map("recipient_type")
  /// Stable recipient key: ADMIN:1 | TEACHER:2 | STUDENT:3 (MySQL-safe uniqueness).
  recipientScopeKey  String                    @map("recipient_scope_key") @db.VarChar(40)
  adminId            Int?                      @map("admin_id")
  teacherId          Int?                      @map("teacher_id")
  studentId          Int?                      @map("student_id")
  title              String                    @db.VarChar(255)
  message            String                    @db.VarChar(1000)
  category           NotificationCategory
  /// Idempotency key per recipient. Unique with scope; use event-specific values.
  dedupeKey          String                    @map("dedupe_key") @db.VarChar(191)
  entityType         String?                   @map("entity_type") @db.VarChar(100)
  entityId           String?                   @map("entity_id") @db.VarChar(100)
  actionPath         String?                   @map("action_path") @db.VarChar(500)
  isRead             Boolean                   @default(false) @map("is_read")
  readAt             DateTime?                 @map("read_at")
  archivedAt         DateTime?                 @map("archived_at")
  deletedAt          DateTime?                 @map("deleted_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  admin   Admin?   @relation("NotificationAdminRecipient", fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teacher Teacher? @relation("NotificationTeacherRecipient", fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  student Student? @relation("NotificationStudentRecipient", fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([recipientScopeKey, dedupeKey], map: "notification_recipient_dedupe_key")
  @@index([recipientType, adminId, isRead, createdAt])
  @@index([recipientType, teacherId, isRead, createdAt])
  @@index([recipientType, studentId, isRead, createdAt])
  @@index([recipientScopeKey, isRead, createdAt])
  @@index([category])
  @@index([archivedAt])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Direct messaging (1:1 conversations between Admin / Teacher / Student)
// ---------------------------------------------------------------------------

enum MessagingActorType {
  ADMIN
  TEACHER
  STUDENT
}

/// One-to-one conversation. pairKey is a sorted "TYPE:id|TYPE:id" uniqueness key.
model Conversation {
  id            Int       @id @default(autoincrement())
  pairKey       String    @unique @map("pair_key") @db.VarChar(80)
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id                  Int                 @id @default(autoincrement())
  conversationId      Int                 @map("conversation_id")
  participantType     MessagingActorType  @map("participant_type")
  /// ADMIN:1 | TEACHER:2 | STUDENT:3
  participantScopeKey String              @map("participant_scope_key") @db.VarChar(40)
  adminId             Int?                @map("admin_id")
  teacherId           Int?                @map("teacher_id")
  studentId           Int?                @map("student_id")
  lastReadAt          DateTime?           @map("last_read_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  admin        Admin?       @relation("ConversationParticipantAdmin", fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teacher      Teacher?     @relation("ConversationParticipantTeacher", fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  student      Student?     @relation("ConversationParticipantStudent", fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([conversationId, participantScopeKey], map: "conversation_participant_unique")
  @@index([participantScopeKey, lastReadAt])
  @@index([adminId])
  @@index([teacherId])
  @@index([studentId])
  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  id             Int                @id @default(autoincrement())
  conversationId Int                @map("conversation_id")
  senderType     MessagingActorType @map("sender_type")
  senderScopeKey String             @map("sender_scope_key") @db.VarChar(40)
  adminId        Int?               @map("admin_id")
  teacherId      Int?               @map("teacher_id")
  studentId      Int?               @map("student_id")
  body           String             @db.VarChar(2000)
  createdAt      DateTime           @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  admin        Admin?       @relation("MessageSentByAdmin", fields: [adminId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacher      Teacher?     @relation("MessageSentByTeacher", fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  student      Student?     @relation("MessageSentByStudent", fields: [studentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderScopeKey])
  @@index([createdAt])
  @@map("messages")
}
