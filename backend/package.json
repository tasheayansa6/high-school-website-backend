{
  "name": "high-school-website-backend",
  "version": "1.0.0",
  "description": "Backend API for the High School Website Platform",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "admin:create-super": "node scripts/create-super-admin.js",
    "test": "node --test tests/*.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:pages": "node --test tests/pages.test.js",
    "test:blog": "node --test tests/blog.test.js",
    "test:contact": "node --test tests/contact.test.js tests/contact-rate-limit.test.js",
    "test:newsletter": "node --test tests/newsletter.test.js",
    "test:admissions": "node --test tests/admissions.test.js tests/admissions-rate-limit.test.js",
    "test:events": "node --test tests/events.test.js",
    "test:media": "node --test tests/media.test.js",
    "test:settings": "node --test tests/settings.test.js",
    "test:dashboard": "node --test tests/dashboard.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1"
  }
}
