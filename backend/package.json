{
  "name": "high-school-website-backend",
  "version": "1.0.0",
  "description": "Backend API for the High School Website Platform",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "admin:create-super": "node scripts/create-super-admin.js",
    "db:backup": "bash scripts/db-backup.sh",
    "db:backup:list": "bash scripts/db-backup-list.sh",
    "db:backup:verify": "bash scripts/db-backup-verify.sh",
    "db:restore:drill": "bash scripts/db-restore-drill.sh",
    "storage:migrate-to-s3": "node scripts/migrate-local-storage-to-s3.js",
    "test": "node scripts/run-tests.js",
    "test:storage": "node --test tests/storage-provider.test.js",
    "test:env": "node --test tests/env-config.test.js",
    "test:monitoring": "node --test tests/monitoring-health.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:pages": "node --test tests/pages.test.js",
    "test:blog": "node --test tests/blog.test.js",
    "test:contact": "node --test tests/contact.test.js tests/contact-rate-limit.test.js",
    "test:newsletter": "node --test tests/newsletter.test.js",
    "test:admissions": "node --test tests/admissions.test.js tests/admissions-rate-limit.test.js",
    "test:events": "node --test tests/events.test.js",
    "test:media": "node --test tests/media.test.js",
    "test:settings": "node --test tests/settings.test.js",
    "test:dashboard": "node --test tests/dashboard.test.js",
    "test:teacher-auth": "node --test tests/teacher-auth.test.js",
    "test:teacher-portal": "node --test tests/teacher-portal.test.js",
    "test:student-auth": "node --test tests/student-auth.test.js",
    "test:student-portal": "node --test tests/student-portal.test.js",
    "test:sms-workflow": "node --test tests/sms-workflow.test.js",
    "test:sms-ops": "node --test tests/sms-ops.test.js",
    "test:cross-portal": "node --test tests/cross-portal-integration.test.js",
    "test:timetable": "node --test tests/timetable.test.js",
    "test:learning-materials": "node --test tests/learning-materials.test.js",
    "test:gradebook": "node --test tests/gradebook.calc.test.js tests/gradebook.test.js",
    "test:notifications": "node --test tests/notifications.test.js",
    "test:messaging": "node --test tests/direct-messaging.test.js",
    "test:sms": "node --test tests/sms-academic.test.js",
    "test:public-academic": "node --test tests/public-academic.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^11.11.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1"
  }
}
