# Application
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins.
# In production this must be an explicit allowlist (wildcard * is rejected).
CORS_ORIGIN=http://localhost:5173

# JSON / urlencoded body size limit
BODY_LIMIT=100kb

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# JWT authentication (required in production; use a random secret ≥ 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-32c
JWT_EXPIRES_IN=8h
JWT_ISSUER=high-school-website-backend
JWT_AUDIENCE=high-school-admin

# Controlled Super Admin bootstrap (used only by npm run admin:create-super)
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=ReplaceWithStrongPass1
# SUPER_ADMIN_FIRST_NAME=Site
# SUPER_ADMIN_LAST_NAME=Admin

# MySQL connection used by Prisma CLI (migrate, introspect, studio)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Replace placeholders with the local MySQL user/database created for this project.
# If the password contains @ : / # ? % & = +, URL-encode those characters in DATABASE_URL.
# Create/reset the user with caching_sha2_password (MySQL 8 default). Avoid sha256_password.
# Prefer 127.0.0.1 over localhost to force TCP (avoids some socket auth quirks).
DATABASE_URL=mysql://school_user:your_password@127.0.0.1:3306/high_school_db

# MySQL connection used by Prisma Client at runtime (via @prisma/adapter-mariadb)
# These values must match DATABASE_URL above.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=school_user
DATABASE_PASSWORD=your_password
DATABASE_NAME=high_school_db

# prisma migrate dev creates a temporary shadow database. The DB user needs CREATE privilege:
#   GRANT CREATE, DROP ON *.* TO 'school_user'@'localhost';
#   FLUSH PRIVILEGES;

CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5

# Admissions public rate limiting
ADMISSIONS_RATE_LIMIT_WINDOW_MS=900000
ADMISSIONS_RATE_LIMIT_MAX=5

# Newsletter public rate limiting
NEWSLETTER_RATE_LIMIT_WINDOW_MS=900000
NEWSLETTER_RATE_LIMIT_MAX=5
NEWSLETTER_CONFIRMATION_TTL_HOURS=48

# Public URLs used inside newsletter emails
API_PUBLIC_URL=http://localhost:5000/api/v1
APP_PUBLIC_URL=http://localhost:5173

# Email delivery
# Use EMAIL_TRANSPORT=json for local development/tests (no real SMTP).
# Use EMAIL_TRANSPORT=smtp in production and set SMTP_* credentials.
EMAIL_TRANSPORT=json
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=School Newsletter <noreply@example.com>

# Media library / uploads (local filesystem; outside src/)
MEDIA_STORAGE_PATH=./storage/uploads
MEDIA_MAX_FILE_SIZE_BYTES=5242880
MEDIA_PUBLIC_BASE_URL=http://localhost:5000/api/v1
MEDIA_RATE_LIMIT_WINDOW_MS=900000
MEDIA_RATE_LIMIT_MAX=30
