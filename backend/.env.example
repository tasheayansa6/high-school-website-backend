# Application
NODE_ENV=development
PORT=5000

# Structured logging level: debug | info | warn | error
# LOG_LEVEL=info

# Optional Sentry error monitoring (leave unset to disable)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0

# Express trust proxy (client IP behind reverse proxies). Leave unset for local/dev.
# Set to 1 on Railway / single nginx hop so rate limits use the real client IP.
# TRUST_PROXY=1

# Comma-separated list of allowed frontend origins.
# In production this must be an explicit allowlist (wildcard * is rejected).
CORS_ORIGIN=http://localhost:5173

# JSON / urlencoded body size limit
BODY_LIMIT=100kb

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# JWT authentication (required in production).
# Generate with: openssl rand -base64 48
# Do not reuse this placeholder; production rejects known example values.
JWT_SECRET=replace-with-a-long-random-secret-32c
JWT_EXPIRES_IN=8h
JWT_ISSUER=high-school-website-backend
JWT_AUDIENCE=high-school-admin
JWT_TEACHER_AUDIENCE=high-school-teacher
JWT_STUDENT_AUDIENCE=high-school-student

# Controlled Super Admin bootstrap (used only by npm run admin:create-super)
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=ReplaceWithStrongPass1
# SUPER_ADMIN_FIRST_NAME=Site
# SUPER_ADMIN_LAST_NAME=Admin

# MySQL connection used by Prisma CLI (migrate, introspect, studio)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Replace placeholders with the local MySQL user/database created for this project.
# If the password contains @ : / # ? % & = +, URL-encode those characters in DATABASE_URL.
# Create/reset the user with caching_sha2_password (MySQL 8 default). Avoid sha256_password.
# Prefer 127.0.0.1 over localhost to force TCP (avoids some socket auth quirks).
DATABASE_URL=mysql://school_user:your_password@127.0.0.1:3306/high_school_db

# MySQL connection used by Prisma Client at runtime (via @prisma/adapter-mariadb)
# These values must match DATABASE_URL above.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=school_user
DATABASE_PASSWORD=your_password
DATABASE_NAME=high_school_db

# Application-managed MySQL logical backups (see docs/PRODUCTION_DATABASE_BACKUP_AND_RESTORATION.md)
# BACKUP_DIR must be outside the git repository. Default: sibling folder ../abyssinia-academy-db-backups
# BACKUP_DIR=/var/backups/abyssinia-academy
# BACKUP_RETENTION_DAYS=14
# BACKUP_PREFIX=abyssinia-academy
# Dedicated database name for restore drills only (never equal to DATABASE_NAME):
# RESTORE_DATABASE_NAME=high_school_db_backup_drill
# Optional MySQL admin used only to CREATE/GRANT the drill database:
# BACKUP_ADMIN_USER=
# BACKUP_ADMIN_PASSWORD=

# prisma migrate dev creates a temporary shadow database. The DB user needs CREATE privilege:
#   GRANT CREATE, DROP ON *.* TO 'school_user'@'localhost';
#   FLUSH PRIVILEGES;

CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5

# Admissions public rate limiting
ADMISSIONS_RATE_LIMIT_WINDOW_MS=900000
ADMISSIONS_RATE_LIMIT_MAX=5

# Newsletter public rate limiting
NEWSLETTER_RATE_LIMIT_WINDOW_MS=900000
NEWSLETTER_RATE_LIMIT_MAX=5
NEWSLETTER_CONFIRMATION_TTL_HOURS=48

# Public URLs used inside newsletter emails
API_PUBLIC_URL=http://localhost:5000/api/v1
APP_PUBLIC_URL=http://localhost:5173

# Email delivery
# Use EMAIL_TRANSPORT=json for local development/tests (no real SMTP).
# Use EMAIL_TRANSPORT=smtp in production and set SMTP_* credentials.
EMAIL_TRANSPORT=json
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=School Newsletter <noreply@example.com>

# Media library / uploads
# STORAGE_PROVIDER=local (default, filesystem) | s3 (private S3-compatible object storage)
STORAGE_PROVIDER=local
MEDIA_STORAGE_PATH=./storage/uploads
MEDIA_MAX_FILE_SIZE_BYTES=5242880
MEDIA_PUBLIC_BASE_URL=http://localhost:5000/api/v1
MEDIA_RATE_LIMIT_WINDOW_MS=900000
MEDIA_RATE_LIMIT_MAX=30

# Learning materials max upload size (default 15 MiB)
# LEARNING_MATERIAL_MAX_FILE_SIZE_BYTES=15728640

# S3-compatible private bucket (AWS S3, Railway Storage Buckets, Cloudflare R2, MinIO, …)
# Required when STORAGE_PROVIDER=s3. Never commit real credentials.
# Railway Buckets also inject BUCKET_* aliases — both naming styles are accepted.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional key prefix inside the bucket (e.g. abyssinia/)
# S3_KEY_PREFIX=
